# GG DEEP DELVE - stash watcher configuration
# Copy this file to `.env` (same folder) and fill in your values.
# .env is gitignored - NEVER commit it or your token.

# Your Project Diablo 2 session token (the JWT the game client / trade site uses).
# PD2 does not publish where to obtain it publicly; the pd2trader desktop app
# documents a read-only PD2 sign-in flow. Get your own token for YOUR account.
PD2_AUTH_TOKEN=

# Your account name (used to label dashboard groups; optional)
PD2_ACCOUNT_NAME=

# Authenticated API base. PD2's authenticated API surface is not publicly
# documented; the script tries these candidate paths in order and logs each
# attempt. Adjust here if your source of the token documents a specific path.
PD2_API_BASE=https://api.projectdiablo2.com
PD2_STASH_PATHS=/api/player/stash,/api/stash,/api/account/stash,/api/player/inventory,/api/v1/stash
