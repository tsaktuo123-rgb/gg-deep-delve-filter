# GG DEEP DELVE - stash watcher configuration
# Copy this file to `.env` (same folder) and fill in your values.
# .env is gitignored - NEVER commit it or your token.

# EASIEST: the script can auto-import the token from the pd2trader desktop app:
#   python scripts/stash_pricer.py --import-token
# (reads %APPDATA%\com.pd2-trader.app\settings.json; never prints or commits it)
# Otherwise paste your PD2 session token here manually:
PD2_AUTH_TOKEN=

# Your account name (used for the /game/stash/<account> endpoint and dashboard labels)
PD2_ACCOUNT_NAME=

# Standings thresholds for --discover (HR values; rares use pd2trader's verdict + bands)
# GG_STAND_HIGH=1.0
# GG_STAND_CHECK=0.3

# Per-machine filter location (only needed if your PD2 install is not on the
# standard layout this project was built on). Folder + file names are separate.
# PD2_FILTER_DIR=E:\D2\Diablo II\Diablo II\ProjectD2\filters\local
# PD2_FILTER_NAME=GG_DEEP_DELVE.filter
# PD2_FILTER_SOURCE_NAME=Hiim_Hyper.filter
